# Census API key -- REQUIRED. Free and issued instantly:
#   https://api.census.gov/data/key_signup.html
# Without it the API returns HTTP 200 + an HTML error page, not a 4xx.
# Used ONLY by the ETL scripts at build time. Never referenced from src/ (it would
# be inlined into the public bundle). Vite only exposes VITE_-prefixed vars, and this
# is deliberately NOT prefixed.
CENSUS_API_KEY=

# Optional: throttle for the ETL fetcher (requests per second)
ETL_RATE_LIMIT_RPS=8

# Harvard Dataverse guestbook -- required ONLY to build the elections layer.
# MEDSL's county returns sit behind a required guestbook; these four fields are
# what it asks for, and the ETL sends them with the download request. No account
# or API token is needed. ETL-only, like the Census key.
# Alternative: download the file once in a browser and drop it at
#   etl/vendor/countypres_2000-2024.csv
# See docs/data-sources.md.
DATAVERSE_NAME=
DATAVERSE_EMAIL=
DATAVERSE_INSTITUTION=
DATAVERSE_POSITION=

# Optional street basemap. Left empty by default: the map needs no third-party
# tiles, and a key embedded in a static client bundle is a public key.
# Self-hosted Protomaps is the recommended upgrade. See docs/data-sources.md.
VITE_BASEMAP_TILES=
VITE_BASEMAP_ATTRIBUTION=
