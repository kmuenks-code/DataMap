{
  "$schema": "./metrics.schema.json",
  "_doc": "Metric registry (leaves of the taxonomy). Every metric declares the layer it belongs to and the group within that layer -- both must exist in layers.json. Adding a metric = an entry here + re-running the ETL. No app code changes. 'kind' drives how the metro baseline is computed and how the value is formatted.",

  "metrics": [
    {
      "id": "median-household-income",
      "label": "Median Household Income",
      "layer": "census-acs",
      "group": "economy",
      "kind": "median",
      "unit": "usd",
      "source": { "dataset": "acs/acs5", "value": "B19013_001E", "moe": "B19013_001M" },
      "baseline": "published",
      "baselineVar": "B19013_001E",
      "higherIsBetter": true,
      "description": "Median income of all households, in inflation-unadjusted dollars of the survey year. The relative index cancels inflation; the raw value does not."
    },
    {
      "id": "population",
      "label": "Total Population",
      "layer": "census-acs",
      "group": "demographics",
      "kind": "count",
      "unit": "people",
      "source": { "dataset": "acs/acs5", "value": "B01003_001E", "moe": "B01003_001M" },
      "baseline": "aggregate",
      "higherIsBetter": null
    },
    {
      "id": "median-home-value",
      "label": "Median Home Value",
      "layer": "census-acs",
      "group": "housing",
      "kind": "median",
      "unit": "usd",
